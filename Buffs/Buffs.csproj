<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>

    <PackageId>Buffs</PackageId>
    <Version>0.0.4</Version>
    <Authors>William Da Friend</Authors>
    <Company>Deer Lord Media</Company>
    <PackageDescription>Buff Tracker</PackageDescription>
    <RepositoryUrl>https://github.com/Deer-Lord-Media/cs-libs</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoolDown" Version="0.0.1" />
  </ItemGroup>

  <PropertyGroup> 
    <!-- GitHub Package Registry -->
    <RestoreAdditionalProjectSources>https://nuget.pkg.github.com/Deer-Lord-Media/index.json</RestoreAdditionalProjectSources>
    <RestoreCredentialsFile>~/.nuget/NuGet/NuGet.Config</RestoreCredentialsFile>
  </PropertyGroup>
</Project>
